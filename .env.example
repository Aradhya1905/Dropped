# Protomaps vector-tile API key — free signup at https://protomaps.com
# Copy this file to `.env` and fill in your key. `.env` is gitignored.
PROTOMAPS_API_KEY=

# Optional: glyph (.pbf) host for the brand font on the map labels.
# Leave blank to use Noto Sans (Protomaps CDN). To render labels in Geist:
#   1. Generate Geist glyphs from assets/fonts/Geist-*.ttf (maps.protomaps.com/fonts)
#   2. Host the resulting fonts/ folder statically (e.g. GitHub Pages)
#   3. Set the {fontstack}/{range}.pbf template below, then fully reload the app.
# MAP_GLYPHS_URL=https://<you>.github.io/<repo>/fonts/{fontstack}/{range}.pbf
MAP_GLYPHS_URL=
